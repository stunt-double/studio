{
  "name": "stuntdouble",
  "version": "0.1.3",
  "description": "Stunt Double Studio: create actors and checklists, run them in a local Chrome on your own model connection or from your coding agent, and keep every run as files in your project",
  "keywords": [
    "stunt-double",
    "testing",
    "browser",
    "checklist",
    "mcp",
    "playwright",
    "agents"
  ],
  "license": "Apache-2.0",
  "author": "Turnout Labs Ltd",
  "homepage": "https://github.com/stunt-double/studio#readme",
  "bugs": {
    "url": "https://github.com/stunt-double/studio/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stunt-double/studio.git"
  },
  "type": "module",
  "bin": {
    "stuntdouble": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "type-check": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "node --test \"test/**/*.test.ts\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm install --lockfile-only",
    "release": "pnpm build && node scripts/publish-npm.mjs",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "playwright-core": "^1.64.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@stuntkit/browser-toolset": "0.2.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-organize-imports": "^4.3.0",
    "tsup": "^9.0.0",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.71.1"
  },
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22.18"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org",
    "provenance": true
  }
}
